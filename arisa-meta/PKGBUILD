# Maintainer: magnus (slimulv1) <magnus@arisa.local>
# Meta-package: installs the whole Arisa AUR fleet in one shot.
pkgname=arisa-meta
pkgver=1
pkgrel=1
pkgdesc='Arisa meta package — toàn bộ đội hình AUR của Arisa (dwm bar, rice, work)'
arch=('any')
url='https://github.com/slimulv1/arisa-repo'
license=('MIT')
depends=(
  'amethyst-mod-manager'
  'anifetch-cli'
  'betterlockscreen'
  'bibata-cursor-theme'
  'code-marketplace'
  'cozette-otb'
  'discord-ptb'
  'evdi-dkms'
  'fcitx5-lotus-bin'
  'hw-probe'
  'lianli-linux-git'
  'libdockapp'
  'light'
  'python-libloot'
  'python-pynput'
  'python-pywal16'
  'python-pywalfox'
  'spoofdpi'
  'visual-studio-code-bin'
  'wmclock'
  'wmcore'
  'wmcpumon'
  'wmitime'
  'wmnet'
  'wmnetload'
  'wmshutdown'
  'wmsystemtray'
)

package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/doc/arisa-meta/README"
  echo "Arisa meta package: cài xong cả đội hình rồi anh! 🖤" > "$pkgdir/usr/share/doc/arisa-meta/README"
}